{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: Run as Module",
        "type": "debugpy",
        "request": "launch",
        "python": "${workspaceFolder}/.venv/bin/python",       // use your venv :contentReference[oaicite:8]{index=8}
        "module": "${command:command-variable.replace(${relativeFile}, '/', '.', 0):regex:replace:.py$::}", 
        "cwd": "${workspaceFolder}",                           // project root :contentReference[oaicite:9]{index=9}
        "console": "integratedTerminal",
        "env": { "PYTHONPATH": "${workspaceFolder}" }          // ensure imports load :contentReference[oaicite:10]{index=10}
      }
    ]
  }
  